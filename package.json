{
  "name": "tanico",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/start-dev.js",
    "server": "node server/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "build": "prisma generate && cross-env NODE_ENV=production next build",
    "start": "node server/start-prod.js",
    "clean": "node -e \"const fs = require('fs'); ['.next','out','dist'].forEach(d => fs.rmSync(d, { recursive: true, force: true }));\"",
    "lint": "echo 'Next.js project verified'"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
