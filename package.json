    "express": "^5.2.1",
    "jose": "^6.2.10",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.9.1",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.14.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.0",
    "eslint-config-next": "15.5.21",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.3.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
