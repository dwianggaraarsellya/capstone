# ==============================================================================
# TaniCo Environment Variables
# Architecture: Next.js Frontend -> Express API -> Prisma -> PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & DEPLOYMENT ROUTING (CRITICAL FOR VERCEL & EXPRESS)
# ------------------------------------------------------------------------------
# [SERVER ONLY] URL of the Express backend in production.
# Example: https://tanico.vercel.app (WITHOUT trailing slash and WITHOUT /api)
# In Next.js SSR and rewrites, this routes all /api/* requests to the Express server.
INTERNAL_API_URL=

# [SERVER ONLY] Allowed frontend origins for CORS in Express.js (comma-separated if multiple).
# Example: https://tanico.vercel.app
FRONTEND_URL=

# [SERVER ONLY] Runtime environment ('development' or 'production').
NODE_ENV=production

# [SERVER ONLY] Express backend port for local/container development (default: 5000).
BACKEND_PORT=5000

# ------------------------------------------------------------------------------
# 2. PRISMA & POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# [SERVER ONLY] Connection URL used by Prisma ORM in Express.
# Example: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=

# [SERVER ONLY] Direct Connection URL used for Prisma migrations (if using pooler).
DIRECT_URL=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# [SERVER ONLY] Secret key (minimum 32 characters) for signing and verifying user session tokens.
# Generate a strong random key (e.g. openssl rand -base64 32)
SESSION_SECRET=

# [SERVER ONLY / PUBLIC] Google OAuth 2.0 Credentials
# Required for Google Sign-In verification
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 4. PLATFORM URL
# ------------------------------------------------------------------------------
APP_URL=
